generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cards {
  id          Int           @id(map: "tarefas_pkey") @default(autoincrement())
  texto       String
  coluna      String        @default("afazer") @db.VarChar(10)
  ordem       Int           @default(0)
  projeto_id  Int
  usuario_id  Int
  criado_em   DateTime?     @default(now()) @db.Timestamp(6)
  projetos    projetos      @relation(fields: [projeto_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "tarefas_projeto_id_fkey")
  usuarios    usuarios      @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "tarefas_usuario_id_fkey")
  comentarios comentarios[]
}

model clientes {
  id               Int       @id @default(autoincrement())
  nome             String    @db.VarChar(100)
  data_nascimentto DateTime  @db.Date
  pedidos          pedidos[]
}

model comentarios {
  id         Int       @id @default(autoincrement())
  texto      String
  tarefa_id  Int
  usuario_id Int
  criado_em  DateTime? @default(now()) @db.Timestamp(6)
  cards      cards     @relation(fields: [tarefa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios   usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model pedidos {
  id            Int             @id @default(autoincrement())
  data          DateTime        @db.Date
  idclientes    Int
  clientes      clientes        @relation(fields: [idclientes], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pedidosintens pedidosintens[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pedidosintens {
  id         Int      @id @default(autoincrement())
  idpedido   Int
  idproduto  Int
  valor      Decimal  @db.Decimal(18, 2)
  desconto   Decimal  @db.Decimal(18, 2)
  quantidade Decimal  @db.Decimal(18, 2)
  pedidos    pedidos  @relation(fields: [idpedido], references: [id], onDelete: NoAction, onUpdate: NoAction)
  produtos   produtos @relation(fields: [idproduto], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model prioridades {
  id        Int       @id @default(autoincrement())
  descricao String    @db.VarChar(50)
  tarefas   tarefas[]
}

model produtos {
  id               Int             @id @default(autoincrement())
  descricao        String          @db.VarChar(100)
  idunidadesmedida Int
  pedidosintens    pedidosintens[]
  unidadesmedida   unidadesmedida  @relation(fields: [idunidadesmedida], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model projetos {
  id         Int       @id @default(autoincrement())
  nome       String    @db.VarChar(100)
  descricao  String?
  usuario_id Int
  criado_em  DateTime? @default(now()) @db.Timestamp(6)
  cards      cards[]
  usuarios   usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tarefas    tarefas[]
}

model tarefas {
  id           Int          @id(map: "tarefas_pkey1") @default(autoincrement())
  texto        String
  coluna       String       @db.VarChar(50)
  projeto_id   Int?
  usuarios_id  Int?
  idprioridade Int?
  prioridades  prioridades? @relation(fields: [idprioridade], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_prioridade")
  projetos     projetos?    @relation(fields: [projeto_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_projeto")
  usuarios     usuarios?    @relation(fields: [usuarios_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_usuario")
}

model unidadesmedida {
  id        Int        @id @default(autoincrement())
  sigla     String     @db.VarChar(3)
  descricao String?    @db.VarChar(30)
  produtos  produtos[]
}

model usuarios {
  id          Int           @id @default(autoincrement())
  nome        String        @db.VarChar(100)
  email       String        @unique @db.VarChar(150)
  senha_hash  String        @db.VarChar(255)
  criado_em   DateTime?     @default(now()) @db.Timestamp(6)
  cards       cards[]
  comentarios comentarios[]
  projetos    projetos[]
  tarefas     tarefas[]
}
